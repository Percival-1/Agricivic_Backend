# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# AWS RDS PostgreSQL Database
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://admin:your_password@your-rds-endpoint.region.rds.amazonaws.com:5432/agri_platform

# Redis (Docker container)
REDIS_URL=redis://localhost:6379/0

# ChromaDB (Docker container)
# Note: ChromaDB runs on port 8001 (mapped from internal 8000)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Translation
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Geoapify Maps API
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Security Keys
SECRET_KEY=your_secret_key_minimum_32_characters_long
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server Settings
MAX_RESPONSE_TIME_SECONDS=30
FORCE_HTTPS=false
