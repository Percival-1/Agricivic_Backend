# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION - AWS ALB DEPLOYMENT
# ============================================================================
# CRITICAL: Generate new secure values for all keys before deployment!
# This file should be created on EC2 instance and NEVER committed to git
# ============================================================================

# ----------------------------------------------------------------------------
# ENVIRONMENT SETTINGS
# ----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# ----------------------------------------------------------------------------
# CORS CONFIGURATION - AWS ALB
# ----------------------------------------------------------------------------
# IMPORTANT: Replace with your actual domain(s)
# Example: ["https://agricivic.shop","https://www.agricivic.shop","https://api.agricivic.shop"]
ALLOWED_ORIGINS=["https://your-domain.com","https://www.your-domain.com"]

# ALB DNS Name (for TrustedHostMiddleware)
# Format: your-alb-name-1234567890.region.elb.amazonaws.com
ALB_DNS_NAME=your-alb-name.region.elb.amazonaws.com

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION - AWS RDS
# ----------------------------------------------------------------------------
# Replace with your RDS endpoint and credentials
DATABASE_URL=postgresql+asyncpg://admin:YOUR_STRONG_PASSWORD@your-rds-endpoint.region.rds.amazonaws.com:5432/agri_platform
DATABASE_ECHO=false

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION - WITH PASSWORD
# ----------------------------------------------------------------------------
# Generate strong password: openssl rand -base64 32
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE
REDIS_URL=redis://:YOUR_STRONG_REDIS_PASSWORD_HERE@localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ----------------------------------------------------------------------------
# CELERY CONFIGURATION
# ----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://:YOUR_STRONG_REDIS_PASSWORD_HERE@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:YOUR_STRONG_REDIS_PASSWORD_HERE@localhost:6379/1

# ----------------------------------------------------------------------------
# VECTOR DATABASE (ChromaDB)
# ----------------------------------------------------------------------------
VECTOR_DB_TYPE=chromadb
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# ----------------------------------------------------------------------------
# EXTERNAL API KEYS
# ----------------------------------------------------------------------------
OPENAI_API_KEY=your_production_openai_api_key
ANTHROPIC_API_KEY=your_production_anthropic_api_key
GOOGLE_TRANSLATE_API_KEY=your_production_google_translate_api_key
GEOAPIFY_API_KEY=your_production_geoapify_api_key
OPENWEATHER_API_KEY=your_production_openweather_api_key

# ----------------------------------------------------------------------------
# LLM CONFIGURATION
# ----------------------------------------------------------------------------
PRIMARY_LLM_PROVIDER=openai
FALLBACK_LLM_PROVIDER=anthropic
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=1000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0

# ----------------------------------------------------------------------------
# COMMUNICATION SERVICES (Twilio SMS)
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_production_twilio_sid
TWILIO_AUTH_TOKEN=your_production_twilio_token
TWILIO_PHONE_NUMBER=your_production_twilio_number

# ----------------------------------------------------------------------------
# SECURITY SETTINGS - CRITICAL!
# ----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_NEW_SECRET_KEY_HERE_MIN_32_CHARS
JWT_SECRET_KEY=GENERATE_NEW_JWT_SECRET_KEY_HERE_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# HTTPS & SECURITY HEADERS - AWS ALB
# ----------------------------------------------------------------------------
# ALB handles SSL termination, but enforce HTTPS redirects
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS=1000
RATE_LIMIT_PERIOD=60

# ----------------------------------------------------------------------------
# INPUT VALIDATION
# ----------------------------------------------------------------------------
MAX_INPUT_LENGTH=10000
MAX_JSON_DEPTH=5

# ----------------------------------------------------------------------------
# ENCRYPTION (Optional but Recommended)
# ----------------------------------------------------------------------------
# Generate with: python -c "import base64; import os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY_HERE

# ----------------------------------------------------------------------------
# APPLICATION SETTINGS
# ----------------------------------------------------------------------------
MAX_RESPONSE_TIME_SECONDS=3
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=["en", "hi", "bn", "te", "ta", "mr", "gu", "kn", "ml", "or"]

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# ----------------------------------------------------------------------------
# CACHE SETTINGS
# ----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_MEMORY_MAX_SIZE=1000
CACHE_DEFAULT_TTL=3600
CACHE_WEATHER_TTL=1800
CACHE_TRANSLATION_TTL=86400
CACHE_MARKET_TTL=3600
CACHE_SCHEME_TTL=43200
CACHE_LLM_TTL=7200
CACHE_SESSION_TTL=3600

# ============================================================================
# AWS ALB HEALTH CHECK
# ============================================================================
# Ensure your ALB health check is configured to:
# - Path: /api/v1/health
# - Port: 8000
# - Protocol: HTTP (ALB handles HTTPS)
# - Healthy threshold: 2
# - Unhealthy threshold: 3
# - Timeout: 5 seconds
# - Interval: 30 seconds
# ============================================================================
